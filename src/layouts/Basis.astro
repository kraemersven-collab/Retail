---
import Kopfbereich from '../components/Kopfbereich.astro';
import Fussbereich from '../components/Fussbereich.astro';
import '../styles/marke.css';

const { titel, beschreibung, jsonld = [] } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta name="author" content="Corinna Krämer" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={kanonisch} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="numana coaching & consulting" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content="https://numana-coaching.de/og-bild.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content="https://numana-coaching.de/og-bild.jpg" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonld.map((eintrag) => (
      <script type="application/ld+json" set:html={JSON.stringify(eintrag)} />
    ))}
  </head>
  <body>
    <Kopfbereich />
    <main>
      <slot />
    </main>
    <Fussbereich />
  </body>
</html>
