---
import Kopfbereich from '../components/Kopfbereich.astro';
import Fussbereich from '../components/Fussbereich.astro';
import '../styles/marke.css';

const { titel, beschreibung, robots } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site);

// Anschrift und Telefonnummer nachtragen, sobald sie feststehen.
// Wichtig: zeichengenau identisch mit dem Google-Unternehmensprofil.
const strukturierteDaten = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'numana, Praxis für systemisches Coaching',
  url: 'https://numana-coaching.de',
  description:
    'Systemisches Coaching für Frauen in analytischen Berufen vor einem beruflichen Wechsel oder einer Führungsrolle. In Münster und online.',
  founder: { '@type': 'Person', name: 'Corinna Krämer' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Münster',
    addressCountry: 'DE',
  },
  areaServed: 'Münster',
  knowsAbout: [
    'Systemisches Coaching',
    'Berufliche Neuorientierung',
    'Karriereentscheidung',
    'Führungsrolle',
  ],
};
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={kanonisch} />
    <script type="application/ld+json" set:html={JSON.stringify(strukturierteDaten)} />
  </head>
  <body>
    <Kopfbereich />
    <main>
      <slot />
    </main>
    <Fussbereich />
  </body>
</html>
