---
import Basis from '../../layouts/Basis.astro';
import Erstgespraech from '../../components/Erstgespraech.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const beitraege = await getCollection('beitraege');
  return beitraege.map((b) => ({
    params: { slug: b.id },
    props: { beitrag: b },
  }));
}

const { beitrag } = Astro.props;
const { Content } = await render(beitrag);

const datumFormat = new Intl.DateTimeFormat('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Basis titel={`${beitrag.data.titel} | numana`} beschreibung={beitrag.data.beschreibung}>
  <article>
    <section class="einstieg">
      <h1>{beitrag.data.titel}</h1>
      <p class="sekundaer">{datumFormat.format(beitrag.data.datum)}</p>
    </section>
    <section class="inhalt">
      <Content />
    </section>
    <section>
      <p>
        Wenn Sie gerade selbst vor einer solchen Entscheidung stehen: Ein
        Erstgespräch zeigt, ob die Arbeit für Sie passt.
      </p>
      <Erstgespraech />
    </section>
  </article>
</Basis>

<style>
  .einstieg {
    padding-top: 4rem;
  }
</style>
