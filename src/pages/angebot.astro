---
import Basis from '../layouts/Basis.astro';

// Zeeg-Buchungslink für das kostenlose Erstgespräch (Direktlink laut Briefing).
const ZEEG_URL = 'https://zeeg.me/kraemer/erstgespraech';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Business & Life Coaching',
    provider: {
      '@type': 'ProfessionalService',
      name: 'numana coaching & consulting',
      url: 'https://numana-coaching.de/',
    },
    areaServed: ['Münster', 'Münsterland'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Coaching-Angebot',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'numana Klarheit',
            description:
              'Der eigentliche Prozess: kostenloses Erstgespräch, LINC-Persönlichkeitsdiagnostik mit Report, separates Auswertungsgespräch (90 Min.) und drei Coaching-Einheiten (je 90 Min.). Festpreis 1.290 Euro, zahlbar in zwei Raten.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'numana Standort',
            description:
              'Einstieg: LINC-Persönlichkeitsdiagnostik mit ausführlichem Report und ein Auswertungsgespräch von 90 Minuten. 390 Euro, wird auf das Kernprogramm angerechnet.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Sparring nach Bedarf',
            description:
              'Einzelne Sparring-Sitzung von 90 Minuten für 220 Euro, wenn später eine konkrete Frage ansteht. Kein Abo, keine Bindung.',
          },
        },
      ],
    },
  },
];
---

<Basis
  titel="Angebot – Coaching-Programm mit LINC-Persönlichkeitsdiagnostik | numana Münster"
  beschreibung="numana Klarheit: ein klar strukturiertes 1:1 Coaching-Programm mit LINC-Persönlichkeitsdiagnostik und definiertem Ergebnis. Für Frauen in Führung und analytischen Berufen. Münster & online. Kostenloses Erstgespräch."
  jsonld={jsonld}
>
  <section style="padding:5rem 0">
    <div class="container">
      <p class="eyebrow">Angebot</p>
      <h2>Ein klarer Weg.<br /><em>Mit definiertem Ende.</em></h2>
      <p style="font-size:0.9rem;color:var(--ink-soft);max-width:52ch;margin-top:1.125rem;line-height:1.78">
        numana ist ein strukturierter Prozess mit festem Umfang. Sie wissen von Anfang an, was Sie bekommen, wie lange es dauert und was es kostet.
      </p>
    </div>
  </section>

  <!-- Typische Anliegen (Briefing Design-Update; die sechs Situationen sind
       verbindlich und werden nicht umformuliert). -->
  <section class="section-alt">
    <div class="container" style="max-width:880px">
      <p class="eyebrow">Typische Anliegen</p>
      <h2>Woran Sie es merken</h2>
      <div style="margin-top:2.25rem">
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">Sie führen zum ersten Mal und merken, dass fachliche Stärke allein die neue Rolle noch nicht trägt.</p></div>
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">Vor Präsentationen und Gremienterminen kostet Sie die Anspannung mehr Kraft als die Vorbereitung.</p></div>
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">In Ihrem Team steht ein Konflikt im Raum, und alle warten darauf, dass Sie ihn lösen.</p></div>
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">Die Zusammenarbeit mit einem anderen Bereich reibt sich an denselben Stellen, egal was Sie verändern.</p></div>
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">Ihre Analysen kommen im Führungskreis an, entschieden wird trotzdem anders.</p></div>
        <div style="display:flex;gap:1rem;padding:1.1rem 0;border-top:0.5px solid var(--rule);border-bottom:0.5px solid var(--rule)"><span style="color:var(--teal-mid);font-weight:500;flex:0 0 auto">+</span><p style="margin:0;font-size:0.92rem;color:var(--ink-soft);line-height:1.7">Sie treffen seit Monaten Entscheidungen, die auf dem Tisch Ihrer Führungskraft liegen müssten, ohne Mandat und ohne Titel.</p></div>
      </div>
      <p style="font-size:0.88rem;color:var(--ink-soft);margin-top:2rem;line-height:1.75">Der erste Schritt ist in allen Fällen derselbe: klären, woran es tatsächlich liegt. Genau dafür ist das <a href={ZEEG_URL} target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px">Erstgespräch</a> da.</p>
    </div>
  </section>

  <!-- Arbeitsprobe (Briefing v2, Punkt 8; Text verbindlich). Der Download
       ersetzt bewusst Testimonials: Die Zielgruppe prüft Qualität selbst. -->
  <section style="padding:3.5rem 0;border-bottom:0.5px solid var(--rule)">
    <div class="container" style="max-width:880px">
      <p class="eyebrow">Zum selbst Prüfen</p>
      <h2>Eine Arbeitsprobe</h2>
      <p style="font-size:0.9rem;color:var(--ink-soft);margin-top:1.25rem;line-height:1.78;max-width:64ch">
        Wie ich arbeite, lässt sich am besten an der Arbeit selbst beurteilen. Dieses Arbeitsblatt führt durch eine erste Selbstprüfung der eigenen Wirkung. Sie können es ohne Anmeldung herunterladen und für sich durchgehen.
      </p>
      <!-- [ARBEITSBLATT-PDF]: Download-Link für das Arbeitsblatt. Wird erst
           gerendert, wenn das Dokument (Skill numana-dokumente) vorliegt —
           gleiche Regel wie [FACTSHEET-PDF], kein toter Link, kein E-Mail-Gate. -->
    </div>
  </section>

  <section style="padding:5rem 0">
    <div class="container">
      <div style="display:grid;grid-template-columns:1.25fr 0.75fr;gap:4rem;align-items:start" class="angebot-grid">
        <div>
          <div class="tier">
            <div>
              <div class="tier-tag">Kernprogramm</div>
              <div class="tier-name">numana Klarheit</div>
              <p class="tier-desc">Der eigentliche Prozess. Wir bestimmen Ihren Standort, machen mit der LINC-Persönlichkeitsdiagnostik Ihre Motive und Kompetenzen sichtbar und arbeiten heraus, wonach die anstehende Entscheidung bei Ihnen zu treffen ist.</p>
              <p class="tier-price"><strong>1.290 €</strong> · Festpreis für den gesamten Prozess.</p>
              <p class="tier-incl">Davor: kostenloses Erstgespräch (30 Min.). Enthalten: LINC-Persönlichkeitsdiagnostik mit ausführlichem Report · Auswertungsgespräch (90 Min.) · drei Coaching-Einheiten (je 90 Min.) · Arbeitsmaterial zwischen den Terminen.</p>
              <p class="tier-note">Keine Umsatzsteuer, keine Zusatzkosten. Zahlbar in zwei Raten.</p>
            </div>
          </div>
          <div class="tier">
            <div>
              <div class="tier-tag">Einstieg</div>
              <div class="tier-name">numana Standort</div>
              <p class="tier-desc">Wenn Sie erst einmal wissen wollen, wonach Sie eigentlich entscheiden. Die LINC-Persönlichkeitsdiagnostik mit ausführlichem Report und ein Auswertungsgespräch von 90 Minuten. Ohne Verpflichtung, wie es weitergeht.</p>
              <p class="tier-price"><strong>390 €</strong> · Wird vollständig angerechnet, wenn Sie danach das Kernprogramm buchen.</p>
            </div>
          </div>
          <div class="tier">
            <div>
              <div class="tier-tag">Danach</div>
              <div class="tier-name">Sparring nach Bedarf</div>
              <p class="tier-desc">Wenn später eine konkrete Frage ansteht, buchen Sie eine einzelne Sitzung. Kein Abo, keine Bindung.</p>
              <p class="tier-price"><strong>220 €</strong> · Einzelsitzung, 90 Minuten.</p>
            </div>
          </div>
          <div style="margin-top:2rem">
            <a class="btn btn-teal" href="/kontakt">Erstgespräch vereinbaren</a>
          </div>
        </div>
        <div style="border:0.5px solid var(--rule);background:var(--paper)">
          <div style="padding:1.25rem 1.5rem;border-bottom:0.5px solid var(--rule);background:var(--teal)">
            <span style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#9FE1CB">Coaching-Themen</span>
          </div>
          <div style="padding:0.7rem 1.5rem;font-size:0.8rem;color:var(--ink-soft);border-bottom:0.5px solid var(--rule)">Beruflich wechseln, ohne ins Nächstbeste zu rutschen</div><div style="padding:0.7rem 1.5rem;font-size:0.8rem;color:var(--ink-soft);border-bottom:0.5px solid var(--rule)">Die Führungsfrage: annehmen, ablehnen oder erst einmal prüfen</div><div style="padding:0.7rem 1.5rem;font-size:0.8rem;color:var(--ink-soft);border-bottom:0.5px solid var(--rule)">Selbständigkeit: die Entscheidung davor, nicht der Businessplan</div><div style="padding:0.7rem 1.5rem;font-size:0.8rem;color:var(--ink-soft);border-bottom:0.5px solid var(--rule)">Eigene Kriterien statt übernommener Erwartungen</div><div style="padding:0.7rem 1.5rem;font-size:0.8rem;color:var(--ink-soft);border-bottom:none">Persönlichkeitsdiagnostik (LINC LPP) als Grundlage einer Entscheidung</div>
        </div>
      </div>
    </div>
  </section>
  <!-- Arbeitgeber-Sektion (Briefing 6a; Texte verbindlich, der
       Vertraulichkeitssatz in Absatz 1 ist Pflicht und wird nicht gekürzt). -->
  <section class="section-alt">
    <div class="container" style="max-width:880px">
      <p class="eyebrow">Auch als Weiterbildung über Ihren Arbeitgeber</p>
      <h2>Viele Unternehmen übernehmen die Kosten</h2>
      <p style="font-size:0.9rem;color:var(--ink-soft);margin-top:1.5rem;line-height:1.78;max-width:64ch">
        Coaching zu Wirksamkeit und Führung ist in vielen Unternehmen Teil des Weiterbildungsbudgets. Wenn Ihr Arbeitgeber die Kosten übernimmt, ändert sich am Ablauf nichts. Die Rechnung geht an das Unternehmen, die Inhalte der Sitzungen bleiben vertraulich zwischen Ihnen und mir.
      </p>
      <p style="font-size:0.9rem;color:var(--ink-soft);margin-top:0.875rem;line-height:1.78;max-width:64ch">
        Für das Gespräch mit Ihrer Führungskraft oder Personalabteilung stelle ich Ihnen ein Argumentationsblatt bereit: Nutzen, Ablauf, Umfang und Kosten auf einer Seite.
      </p>
      <p style="font-size:0.9rem;color:var(--ink-soft);margin-top:0.875rem;line-height:1.78;max-width:64ch">
        Ob privat oder über den Arbeitgeber, das Erstgespräch ist in beiden Fällen kostenlos und unverbindlich.
      </p>
      <!-- [FACTSHEET-PDF]: Download-Slot für das Argumentationsblatt.
           Das Dokument entsteht separat (Skill numana-dokumente) und wird vor
           dem Launch eingehängt. Bis dahin wird hier bewusst kein Link
           gerendert, damit kein toter Link live geht. -->
    </div>
  </section>

  <section style="padding:5rem 0">
    <div class="container" style="max-width:880px">
      <p class="eyebrow">Methode</p>
      <h2>Womit ich <em>arbeite.</em></h2>
      <div class="herkunft-methoden" style="border-top:none;padding-top:0;margin-top:2.25rem">
        <div class="herkunft-methode">
          <p class="herkunft-label">LINC Persönlichkeitsdiagnostik · Big Five</p>
          <p class="herkunft-text herkunft-text--klein">
            Strukturierte Diagnostik statt Methodenmix. Der LINC Personality Profiler macht
            sichtbar, wie Sie tatsächlich wirken: Persönlichkeit, Motive, Kompetenzen. Das
            Vorgehen, das Sie aus dem Beruf kennen, angewendet auf Ihre eigene Lage. Den
            vollständigen Report erhalten Sie, auch wenn wir danach nicht weiterarbeiten.
          </p>
        </div>
        <div class="herkunft-methode">
          <p class="herkunft-label">Systemisch · DBI Berlin</p>
          <p class="herkunft-text herkunft-text--klein">
            Ein Profil erklärt noch keine Entscheidung. Systemisch heißt: Ihre Entscheidung
            steht in Rollen, Beziehungen und Erwartungen und genau dort schauen wir hin.
            Gearbeitet wird diagnostisch: Bevor wir an Verhalten arbeiten, klären wir,
            woran es tatsächlich lag. An der Form, an der Position oder an der Botschaft
            selbst. Diese Unterscheidung entscheidet darüber, wo Anstrengung Ertrag bringt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <p class="eyebrow">Ablauf</p>
      <h2>Fünf Schritte. <em>Fester Umfang.</em></h2>
      <div class="steps steps-5">
        <div class="step-box"><div class="step-n" aria-hidden="true">01</div><div class="step-t">Erstgespräch</div><p class="step-d">30 Minuten, kostenlos. Wir prüfen, ob es passt.</p></div>
        <div class="step-box"><div class="step-n" aria-hidden="true">02</div><div class="step-t">LINC-Persönlich&shy;keits&shy;diagnostik</div><p class="step-d">Online-Fragebogen, ausführlicher Ergebnisreport. Persönlichkeit, Motive, Kompetenzen.</p></div>
        <div class="step-box"><div class="step-n" aria-hidden="true">03</div><div class="step-t">Auswertungsgespräch</div><p class="step-d">90 Minuten. Was das Profil über Ihre Kriterien sagt und wo es Ihrer Selbsteinschätzung widerspricht.</p></div>
        <div class="step-box"><div class="step-n" aria-hidden="true">04</div><div class="step-t">Drei Coaching-Einheiten</div><p class="step-d">Je 90 Minuten, im Abstand von ein bis zwei Wochen. Mit Arbeitsmaterial für die Zeit dazwischen.</p></div>
        <div class="step-box"><div class="step-n" aria-hidden="true">05</div><div class="step-t">Abschluss</div><p class="step-d">Ihre Frage. Ihre Kriterien. Ihr erster Schritt.</p></div>
      </div>
      <div class="scope">
        <div class="scope-item"><span class="scope-k">Umfang</span><span class="scope-v">5 Termine</span></div>
        <div class="scope-item"><span class="scope-k">Zeitraum</span><span class="scope-v">6 bis 8 Wochen</span></div>
        <div class="scope-item"><span class="scope-k">Gesprächszeit</span><span class="scope-v">6,5 Stunden</span></div>
        <div class="scope-item scope-price"><span class="scope-k">Festpreis</span><span class="scope-v">1.290 €</span></div>
      </div>
      <p class="scope-note">Das Erstgespräch ist kostenlos. Im Festpreis enthalten sind die LINC-Persönlichkeitsdiagnostik, der vollständige Ergebnisreport und das Arbeitsmaterial. Keine Verlängerung, keine Zusatzkosten.</p>
    </div>
  </section>
</Basis>

<style>
  @media (max-width: 860px) {
    .angebot-grid {
      grid-template-columns: 1fr !important;
      gap: 2.5rem !important;
    }
  }
</style>
