---
import Basis from '../layouts/Basis.astro';
---

<Basis
  titel="Impressum | numana Coaching Münster"
  beschreibung="Anbieterkennzeichnung der Coaching-Praxis numana, Corinna Krämer, Münster."
  robots="noindex"
>
  <section class="einstieg">
    <h1>Impressum</h1>
    <p class="entwurf">
      Entwurf. Vor Veröffentlichung die Platzhalter ergänzen und den Text durch
      eine fachkundige Stelle prüfen lassen.
    </p>
  </section>

  <section>
    <h2>Angaben gemäß § 5 DDG</h2>
    <p>
      numana, Praxis für systemisches Coaching<br />
      Corinna Krämer<br />
      [Straße und Hausnummer]<br />
      [PLZ] Münster
    </p>
    <h2>Kontakt</h2>
    <p>
      Telefon: [Telefonnummer]<br />
      E-Mail: kontakt@numana-coaching.de
    </p>
    <h2>Berufsbezeichnung</h2>
    <p>Systemische Coach, tätig als Einzelunternehmerin.</p>
    <h2>Umsatzsteuer</h2>
    <p>
      [Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG, falls vorhanden,
      andernfalls diesen Abschnitt entfernen.]
    </p>
    <h2>Verantwortlich für den Inhalt</h2>
    <p>Corinna Krämer, Anschrift wie oben.</p>
  </section>
</Basis>

<style>
  .einstieg {
    padding-top: 4rem;
  }
  .entwurf {
    background: var(--flaeche-hell);
    border-left: 3px solid var(--gruen-akzent);
    padding: 0.75rem 1rem;
    color: var(--text-sekundaer);
    font-size: 0.95rem;
  }
</style>
