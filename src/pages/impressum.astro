---
import Basis from '../layouts/Basis.astro';
---

<Basis
  titel="Impressum | numana coaching & consulting"
  beschreibung="Impressum von numana coaching & consulting, Corinna Krämer, Münster."
>
  <section style="padding:5rem 0">
    <div class="container" style="max-width:660px">
      <p class="eyebrow">Rechtliches</p>
      <h2>Impressum</h2>
      <div style="margin-top:2rem;display:flex;flex-direction:column;gap:2rem">
        <div style="padding-bottom:2rem;border-bottom:0.5px solid var(--rule)">
          <h3 style="font-family:var(--sans);font-size:0.88rem;font-weight:500;color:var(--ink);margin-bottom:0.875rem">Angaben gemäß § 5 DDG</h3>
          <p style="font-size:0.85rem;color:var(--ink-soft)">Corinna Krämer<br />numana coaching &amp; consulting<br />Käthe-Ernst-Weg 52<br />48161 Münster</p>
        </div>
        <div style="padding-bottom:2rem;border-bottom:0.5px solid var(--rule)">
          <h3 style="font-family:var(--sans);font-size:0.88rem;font-weight:500;color:var(--ink);margin-bottom:0.875rem">Kontakt</h3>
          <p style="font-size:0.85rem;color:var(--ink-soft)">E-Mail: <a href="mailto:kraemer@numana-coaching.de" style="color:var(--teal)">kraemer@numana-coaching.de</a></p>
        </div>
        <div style="padding-bottom:2rem;border-bottom:0.5px solid var(--rule)">
          <h3 style="font-family:var(--sans);font-size:0.88rem;font-weight:500;color:var(--ink);margin-bottom:0.875rem">Angaben zur Berufshaftpflichtversicherung</h3>
          <p style="font-size:0.85rem;color:var(--ink-soft)">Name und Sitz des Versicherers:<br />exali AG<br />Franz-Kobinger-Str. 9<br />86157 Augsburg</p>
        </div>
        <div>
          <h3 style="font-family:var(--sans);font-size:0.88rem;font-weight:500;color:var(--ink);margin-bottom:0.875rem">Verbraucherstreitbeilegung / Universalschlichtungsstelle</h3>
          <p style="font-size:0.85rem;color:var(--ink-soft)">Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
          <p style="font-size:0.72rem;color:var(--ink-mute);margin-top:1rem">Quelle: e-recht24.de</p>
        </div>
      </div>
    </div>
  </section>
</Basis>
