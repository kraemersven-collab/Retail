---
import Basis from '../layouts/Basis.astro';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'numana coaching & consulting',
    alternateName: 'numana – Corinna Krämer',
    description:
      '1:1 Coaching für Frauen in analytischen Berufen, vor denen eine berufliche Entscheidung liegt: ein Wechsel, eine Führungsrolle oder der Schritt in die Selbständigkeit. Systemisch fundiert, mit LINC-Persönlichkeitsdiagnostik.',
    url: 'https://numana-coaching.de/',
    email: 'kraemer@numana-coaching.de',
    image: 'https://numana-coaching.de/corinna-portrait.jpg',
    areaServed: ['Münster', 'Münsterland', 'Nordrhein-Westfalen'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Münster',
      addressRegion: 'Nordrhein-Westfalen',
      addressCountry: 'DE',
    },
    knowsLanguage: 'de',
    priceRange: '€€',
    founder: {
      '@type': 'Person',
      name: 'Corinna Krämer',
      jobTitle: 'Business & Life Coach',
      description:
        'Bankkauffrau, Versicherungsfachfrau, Diplom-Kauffrau und ehemalige Prokuristin. Über zwei Jahrzehnte in Banken, Versicherungen und im Ingenieurwesen. Zertifizierter LINC Personality Profiler Coach, ausgebildet am Dr. Bock Institute (DBI) Berlin.',
      knowsAbout: [
        'Business Coaching',
        'Life Coaching',
        'berufliche Neuorientierung',
        'Jobwechsel',
        'Führungsrolle',
        'Selbständigkeit',
        'LINC Personality Profiler',
        'Persönlichkeitsdiagnostik',
      ],
    },
  },
];
---

<Basis
  titel="Coaching für Frauen vor einer beruflichen Entscheidung | numana · Münster"
  beschreibung="1:1 Coaching für Frauen in analytischen Berufen: Jobwechsel, Führungsrolle oder Selbständigkeit. Systemisch, mit LINC-Persönlichkeitsdiagnostik. Münster und online. Festpreis 1.290 €."
  jsonld={jsonld}
>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <p class="hero-eyebrow"><span>Systemisches Business &amp; Life Coaching für Frauen<br />Münster &amp; Münsterland · online</span></p>
          <p class="hero-leitsatz">Sie analysieren Systeme.<br /><em>Zeit, das eigene zu verstehen.</em></p>
          <h1 class="hero-h1">Der naheliegende nächste Schritt<br />ist <em>nicht immer der richtige.</em></h1>
          <div class="hero-subs">
            <p class="hero-sub hero-sub-lead">1:1 Coaching für Frauen in analytischen Berufen, vor denen eine berufliche Entscheidung liegt. Der Wechsel, der ansteht. Die Führungsrolle, die angeboten wird. Der Schritt in die Selbständigkeit.</p>
            <p class="hero-sub hero-sub-em">Wir klären nicht, ob Sie es können. Das wissen Sie.<br />Wir klären, wonach Sie entscheiden.</p>
            <p class="hero-sub">Systemisch fundiert, mit LINC-Persönlichkeitsdiagnostik. Keine Esoterik, kein offenes Ende.</p>
          </div>
          <div class="hero-btns">
            <a class="btn btn-sand" href="/kontakt">Erstgespräch vereinbaren</a>
            <a class="btn btn-outline-light" href="#methodik">Wie ich arbeite</a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat"><div class="stat-n">25+</div><div class="stat-l">Jahre in Banken, Versicherungen und im Ingenieurwesen</div></div>
            <div class="hero-stat"><div class="stat-n">DBI</div><div class="stat-l">Ausgebildet am DBI Berlin</div></div>
            <div class="hero-stat"><div class="stat-n">LINC</div><div class="stat-l">Persönlichkeitsdiagnostik (Big Five)</div></div>
          </div>
        </div>
        <div class="hero-photo-wrap hero-photo-sm">
          <div class="hero-photo">
            <img id="hero-img" src="/corinna-portrait.jpg" alt="Corinna Krämer, Business und Life Coach, Münster" onerror="this.style.display='none'" />
          </div>
          <div class="hero-label">
            <strong>Corinna Krämer</strong>
            <span>Business &amp; Life Coach</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background:#F7F4EF;padding:5rem 0">
    <div class="container">
      <p class="eyebrow">Kennen Sie das?</p>
      <h2>Fünf Fragen. <em>Wenn eine davon Ihre ist,<br />sind Sie richtig.</em></h2>
      <p style="font-size:0.95rem;color:var(--ink-soft);max-width:52ch;margin-top:1rem">
        Sie sind präzise, strukturiert, leistungsfähig. Und dann steht eine Entscheidung an, die sich nicht weganalysieren lässt.
      </p>
      <div class="bento bento-5">
        <div class="bento-item">
          <div class="bento-n">01</div>
          <p class="bento-q">Ich will wechseln — und merke, dass ich gerade wieder in dasselbe hineinlaufen würde.</p>
        </div>
        <div class="bento-item">
          <div class="bento-n">02</div>
          <p class="bento-q">Mir wird eine Führungsrolle angeboten. Will ich sie, oder wachse ich nur hinein?</p>
        </div>
        <div class="bento-item">
          <div class="bento-n">03</div>
          <p class="bento-q">Ich denke seit Monaten daran, mich selbständig zu machen. Ist das mein Weg oder eine Fluchtbewegung?</p>
        </div>
        <div class="bento-item">
          <div class="bento-n">04</div>
          <p class="bento-q">Ich funktioniere seit Jahren zuverlässig. Woran erkenne ich, ob das noch mein Weg ist?</p>
        </div>
        <div class="bento-item bento-wide">
          <div class="bento-n">05</div>
          <p class="bento-q">Wonach entscheide ich das eigentlich? Und wessen Kriterien habe ich bisher benutzt?</p>
        </div>
      </div>
      <p style="font-size:0.85rem;color:var(--ink-soft);font-style:italic;margin-top:1.5rem">
        Die fünfte Frage ist die, auf die alle anderen zulaufen.
      </p>
    </div>
  </section>

  <section id="anlass" class="section-alt">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Anlass</p>
      <h2>Kommt Ihnen das <em>bekannt vor?</em></h2>
      <div class="assure">
        <div class="assure-item">
          <p>Sie tragen eine Einschätzung vor, fachlich belastbar, und es folgt keine Entscheidung.</p>
        </div>
        <div class="assure-item">
          <p>Jemand von außen sagt kurz darauf dasselbe, und plötzlich bewegt sich etwas.</p>
        </div>
        <div class="assure-item">
          <p>Sie werden zu einer Maßnahme geschickt, die am eigentlichen Problem vorbeigeht.</p>
        </div>
        <div class="assure-item">
          <p>Sie fragen sich, ob Sie bleiben oder gehen sollten, und finden keinen sachlichen Grund für die eine oder andere Seite.</p>
        </div>
      </div>
      <p class="outcome-close">Das sind keine Kommunikationsprobleme. Es sind drei verschiedene Ursachen, die sich von innen gleich anfühlen.</p>
    </div>
  </section>

  <!-- Das numana-Prinzip.
       Vorgesehener Platz für die Beschreibung des numana-Prinzips: die Grundhaltung
       hinter der Arbeit, formuliert im Anschluss an Anlass und Methodik und vor dem
       Ergebnisabschnitt. Bleibt bis zur Freigabe des Textes ohne sichtbaren Inhalt. -->

  <section id="methodik" style="padding:5rem 0">
    <div class="container">
      <p class="eyebrow">Methodik</p>
      <h2>numerus trifft <em>humana.</em></h2>
      <div class="method-grid">
        <div class="method-card">
          <div class="method-badge">Systemisch · DBI Berlin</div>
          <h3>numerus</h3>
          <p>Strukturierte Diagnostik statt Methodenmix. Mit dem LINC Personality Profiler machen wir sichtbar, wie Sie tatsächlich funktionieren: Persönlichkeit, Motive, Kompetenzen. Das Vorgehen, das Sie aus dem Beruf kennen, angewendet auf Ihre eigene Lage.</p>
          <p>Gearbeitet wird diagnostisch. Bevor an Verhalten gearbeitet wird, klären wir, woran es tatsächlich lag. Manches liegt an der Form, manches an der Position, manches am Inhalt selbst. Diese Unterscheidung entscheidet darüber, wo Anstrengung Ertrag bringt.</p>
        </div>
        <div class="method-card">
          <div class="method-badge">LINC Persönlichkeitsdiagnostik · Big Five</div>
          <h3>humana</h3>
          <p>Ein Profil erklärt noch keine Entscheidung. Sie reden, ich stelle die Fragen, die Sie sich selbst nicht stellen. Auf Augenhöhe, in Ihrem Tempo, mit ehrlichem Feedback.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <p class="eyebrow">Was am Ende vorliegt</p>
      <h2>Nach dem Prozess<br />haben Sie <em>drei Dinge.</em></h2>
      <div class="outcome">
        <div class="outcome-item">
          <div class="outcome-n">01</div>
          <h3>Ihre Entscheidungsfrage</h3>
          <p>Präzise formuliert, statt diffus im Kopf.</p>
        </div>
        <div class="outcome-item">
          <div class="outcome-n">02</div>
          <h3>Ihre eigenen Kriterien</h3>
          <p>Woran Sie messen. Und welche davon eigentlich fremde sind.</p>
        </div>
        <div class="outcome-item">
          <div class="outcome-n">03</div>
          <h3>Einen ersten Schritt</h3>
          <p>Mit Datum.</p>
        </div>
      </div>
      <p class="outcome-close">Treffen werden Sie die Entscheidung selbst. Das ist keine Einschränkung, sondern der Punkt.</p>
      <div class="fit-note">
        <p class="fit-k">Wenn es nicht passt.</p>
        <p class="fit-t">Wenn sich im Erstgespräch zeigt, dass ich nicht die Richtige bin, sage ich Ihnen das. Und wenn Sie nach der ersten Einheit merken, dass es nicht passt, beenden wir den Prozess und rechnen nur ab, was stattgefunden hat.</p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <p class="eyebrow">Weiterlesen</p>
      <h2>Wie es <em>weitergeht.</em></h2>
      <div class="next-grid">
        <a class="next-card" href="/angebot"><span class="next-k">Ablauf &amp; Preise</span><span class="next-t">Fünf Schritte, fester Umfang, Festpreis.</span><span class="next-a">Zum Angebot</span></a>
        <a class="next-card" href="/ueber-mich"><span class="next-k">Über mich</span><span class="next-t">25 Jahre Zahlen — und drei Fragen an Corinna.</span><span class="next-a">Mehr erfahren</span></a>
        <a class="next-card" href="/kontakt"><span class="next-k">Bevor Sie schreiben</span><span class="next-t">Was vertraulich bleibt, und wo meine Arbeit aufhört.</span><span class="next-a">Zum Kontakt</span></a>
      </div>
    </div>
  </section>
  <div class="cta-band">
    <div class="container">
      <p class="eyebrow center light">Lassen Sie uns reden</p>
      <h2>30 Minuten, die Ihren Standort klären.</h2>
      <p>Kostenlos. Unverbindlich. Vertraulich. 30 Minuten, in denen wir prüfen, ob es passt.</p>
      <a class="cta-prime" href="/kontakt"><span class="arrow">&gt;&gt;&gt;</span>Erstgespräch vereinbaren</a>
    </div>
  </div>
</Basis>
