---
import Basis from '../layouts/Basis.astro';

// Zeeg-Buchungslink für das kostenlose Erstgespräch (Direktlink laut Briefing).
const ZEEG_URL = 'https://zeeg.me/kraemer/erstgespraech';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'numana coaching & consulting',
    alternateName: 'numana – Corinna Krämer',
    description:
      '1:1 Coaching für Frauen in analytischen Berufen, vor denen eine berufliche Entscheidung liegt: ein Wechsel, eine Führungsrolle oder der Schritt in die Selbständigkeit. Systemisch fundiert, mit LINC-Persönlichkeitsdiagnostik.',
    url: 'https://numana-coaching.de/',
    email: 'kraemer@numana-coaching.de',
    image: 'https://numana-coaching.de/corinna-portrait.jpg',
    areaServed: ['Münster', 'Münsterland', 'Nordrhein-Westfalen'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Münster',
      addressRegion: 'Nordrhein-Westfalen',
      addressCountry: 'DE',
    },
    knowsLanguage: 'de',
    priceRange: '€€',
    founder: {
      '@type': 'Person',
      name: 'Corinna Krämer',
      jobTitle: 'Business & Life Coach',
      description:
        'Bankkauffrau, Versicherungsfachfrau, Diplom-Kauffrau und ehemalige Prokuristin. 25 Jahre in Banken, Versicherungen und im Ingenieurwesen. Zertifizierter LINC Personality Profiler Coach, abgeschlossene systemische Coaching-Ausbildung am Dr. Bock Institute (DBI) Berlin.',
      knowsAbout: [
        'Business Coaching',
        'Life Coaching',
        'berufliche Neuorientierung',
        'Jobwechsel',
        'Führungsrolle',
        'Selbständigkeit',
        'LINC Personality Profiler',
        'Persönlichkeitsdiagnostik',
      ],
    },
  },
];
---

<Basis
  titel="Coaching für Frauen vor einer beruflichen Entscheidung | numana · Münster"
  beschreibung="1:1 Coaching für Frauen in analytischen Berufen: Jobwechsel, Führungsrolle oder Selbständigkeit. Systemisch, mit LINC-Persönlichkeitsdiagnostik. Münster und online. Festpreis 1.290 €."
  jsonld={jsonld}
>
  <section class="hero">
      <div class="hero-grid">
        <div class="hero-photo-wrap hero-photo-links">
          <div class="hero-photo">
            <img id="hero-img" src="/corinna-portrait.jpg" alt="Corinna Krämer, Business und Life Coach, Münster" onerror="this.style.display='none'" />
          </div>
          <div class="hero-label">
            <strong>Corinna Krämer</strong>
            <span>Business &amp; Life Coach</span>
          </div>
        </div>
        <div class="hero-inhalt">
          <p class="hero-eyebrow"><span>Systemisches Coaching für Frauen <br />Münster · online</span></p>
          <h1 class="hero-h1">Der naheliegende nächste Schritt <br />ist <em>nicht immer der richtige.</em></h1>
          <div class="hero-subs">
            <p class="hero-sub hero-sub-lead">Für Frauen in Finance, Controlling, Engineering und IT, die vor einer beruflichen Entscheidung stehen: ein Wechsel, eine Führungsrolle oder die Selbständigkeit.</p>
            <p class="hero-sub hero-sub-em">Wir klären nicht, ob Sie es können. Das wissen Sie.<br />Wir klären, wonach Sie entscheiden.</p>
          </div>
          <div class="hero-btns">
            <a class="btn btn-teal" href="/kontakt">Erstgespräch vereinbaren</a>
            <a class="btn btn-ghost" href="/angebot">Wie ich arbeite</a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat"><div class="stat-n">25</div><div class="stat-l">Jahre in Banken, Versicherungen und im Ingenieurwesen</div></div>
            <div class="hero-stat"><div class="stat-n">Prokura</div><div class="stat-l">Personal und Finanzen verantwortet</div></div>
            <div class="hero-stat"><div class="stat-n">LINC</div><div class="stat-l">Persönlichkeitsdiagnostik (Big Five)</div></div>
          </div>
        </div>
      </div>
  </section>

  <section style="background:#F7F4EF;padding:5rem 0">
    <div class="container">
      <p class="eyebrow">Kennen Sie das?</p>
      <h2>Fünf Fragen. <em>Wenn eine davon Ihre ist,<br />sind Sie richtig.</em></h2>
      <p style="font-size:0.95rem;color:var(--ink-soft);max-width:52ch;margin-top:1rem">
        Sie sind präzise, strukturiert, leistungsfähig. Und dann steht eine Entscheidung an, die sich nicht weganalysieren lässt.
      </p>
      <div class="bento bento-5">
        <div class="bento-item">
          <div class="bento-n" aria-hidden="true">01</div>
          <p class="bento-q">Ich funktioniere gut. Aber wofür eigentlich?</p>
          <p class="bento-erkl">Die Zahlen stimmen, die Rolle stimmt auf dem Papier. Etwas anderes stimmt nicht.</p>
        </div>
        <div class="bento-item">
          <div class="bento-n" aria-hidden="true">02</div>
          <p class="bento-q">Soll ich die Führungsrolle annehmen?</p>
          <p class="bento-erkl">Sie könnten, das steht fest. Offen ist, ob Sie wollen und woran Sie das erkennen.</p>
        </div>
        <div class="bento-item">
          <div class="bento-n" aria-hidden="true">03</div>
          <p class="bento-q">Ist der Wechsel die Lösung oder nur die Bewegung?</p>
          <p class="bento-erkl">Ein neuer Arbeitgeber verändert die Bedingungen. Ihre eigenen Muster ziehen mit um.</p>
        </div>
        <div class="bento-item">
          <div class="bento-n" aria-hidden="true">04</div>
          <p class="bento-q">Trägt die Selbständigkeit oder nur die Idee davon?</p>
          <p class="bento-erkl">Das lässt sich nüchtern prüfen, mit Ihren eigenen Kriterien.</p>
        </div>
        <div class="bento-item bento-wide">
          <div class="bento-n" aria-hidden="true">05</div>
          <p class="bento-q">Wonach entscheide ich das eigentlich?</p>
          <p class="bento-erkl">Die Frage hinter den anderen vier. Und die einzige, die sich mit keiner Tabelle beantworten lässt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dunkle Sektion mit dem Entlastungssatz (Briefing v2, Punkt 2;
       Text verbindlich, wird nicht umformuliert). Der Markensatz steht
       wieder im Hero. Das numana-Prinzip würde nach Freigabe hier andocken. -->
  <section style="background:var(--teal-dark);padding:clamp(6rem,12vw,9rem) 0">
    <div class="container" style="max-width:880px;text-align:center">
      <p style="font-family:var(--serif);font-weight:400;font-size:clamp(1.4rem,3vw,2rem);line-height:1.5;color:var(--teal-soft)">Dass Sie die Ursache zuerst bei sich suchen, spricht für Sie. Es ist die Haltung, die den Glauben erhält, dass Anstrengung wirkt. Manchmal stimmt sie. Und manchmal liegt die Ursache an einer Stelle, die Sie von innen allein kaum sehen können.</p>
      <p style="font-size:0.95rem;margin-top:2.5rem"><a href={ZEEG_URL} target="_blank" rel="noopener" style="color:var(--paper);text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--brand-rule)">Genau das lässt sich prüfen.</a></p>
    </div>
  </section>

  <section style="background:var(--teal-bg);border-top:0.5px solid var(--rule);border-bottom:0.5px solid var(--rule);padding:5rem 0">
    <div class="container">
      <p class="eyebrow">Was am Ende vorliegt</p>
      <h2>Nach dem Prozess<br />haben Sie <em>drei Dinge.</em></h2>
      <div class="outcome">
        <div class="outcome-item">
          <div class="outcome-n" aria-hidden="true">01</div>
          <h3>Ihre Entscheidungsfrage</h3>
          <p>Präzise formuliert. Häufig eine andere als die, mit der Sie gekommen sind.</p>
        </div>
        <div class="outcome-item">
          <div class="outcome-n" aria-hidden="true">02</div>
          <h3>Ihre eigenen Kriterien</h3>
          <p>Woran Sie messen. Und welche davon eigentlich fremde sind.</p>
        </div>
        <div class="outcome-item">
          <div class="outcome-n" aria-hidden="true">03</div>
          <h3>Einen ersten Schritt</h3>
          <p>Mit Datum.</p>
        </div>
      </div>
      <p class="outcome-close">Treffen werden Sie die Entscheidung selbst. Genau dafür ist der Prozess gebaut.</p>
      <div class="fit-note" style="background:var(--paper)">
        <p class="fit-k">Wenn es nicht passt.</p>
        <p class="fit-t">Wenn sich im Erstgespräch zeigt, dass ich nicht die Richtige bin, sage ich Ihnen das. Und wenn Sie nach der ersten Einheit merken, dass es nicht passt, beenden wir den Prozess. Berechnet wird nur, was stattgefunden hat: die Diagnostik zum Preis von numana Standort, jede Coaching-Einheit zum Preis einer Einzelsitzung.</p>
      </div>
    </div>
  </section>


  <section class="section-alt">
    <div class="container">
      <p class="eyebrow">Weiterlesen</p>
      <h2>Wie es <em>weitergeht.</em></h2>
      <div class="next-grid">
        <a class="next-card" href="/angebot"><span class="next-k">Ablauf &amp; Preise</span><span class="next-t">Fünf Termine, sechs bis acht Wochen, 1.290 € Festpreis.</span><span class="next-a">Zum Angebot</span></a>
        <a class="next-card" href="/ueber-mich"><span class="next-k">Über mich</span><span class="next-t">25 Jahre Zahlen und warum ich heute Fragen stelle.</span><span class="next-a">Mehr erfahren</span></a>
        <a class="next-card" href="/kontakt"><span class="next-k">Bevor Sie schreiben</span><span class="next-t">Was Sie vom Erstgespräch erwarten können und was nicht.</span><span class="next-a">Zum Kontakt</span></a>
      </div>
    </div>
  </section>
  <div class="cta-band">
    <div class="container">
      <p class="eyebrow center light">Lassen Sie uns reden</p>
      <h2>30 Minuten, die Ihren Standort klären.</h2>
      <p>Kostenlos, vertraulich und ohne Verkaufsgespräch. Sie brauchen kein fertiges Anliegen.</p>
      <a class="cta-prime" href="/kontakt"><span class="arrow">&gt;&gt;&gt;</span>Erstgespräch vereinbaren</a>
    </div>
  </div>
</Basis>
