---
// Der eine Handlungsaufruf der Seite. Beschriftung nie ändern.
const { kompakt = false } = Astro.props;
---

<div class="erstgespraech">
  <a class="knopf" href="/kontakt">Erstgespräch vereinbaren</a>
  {!kompakt && (
    <p class="fakten sekundaer">
      Kostenlos, etwa 30 Minuten, per Telefon oder Video. Es verpflichtet Sie zu nichts.
    </p>
  )}
</div>

<style>
  .erstgespraech {
    margin: 1.5rem 0 0.5rem;
  }
  .fakten {
    margin-top: 0.75rem;
    margin-bottom: 0;
  }
</style>
