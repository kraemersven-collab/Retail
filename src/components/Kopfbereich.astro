---
const pfad = Astro.url.pathname;
const punkte = [
  { titel: 'Startseite', pfad: '/' },
  { titel: 'Über mich', pfad: '/ueber-mich' },
  { titel: 'Angebot', pfad: '/angebot' },
  { titel: 'Kontakt', pfad: '/kontakt' },
];
const aktiv = (p) => pfad === p || pfad === p + '/';
---

<nav aria-label="Hauptnavigation">
  <a class="nav-logo" href="/" aria-label="numana – Startseite"
    ><img
      src="/numana-logo-nav.png"
      alt="numana coaching &amp; consulting"
      onerror="this.style.display='none';this.parentElement.textContent='numana'"
    /></a
  >
  <ul class="nav-links" role="list">
    {punkte.map((p) => (
      <li>
        <a
          href={p.pfad}
          class={aktiv(p.pfad) ? 'active' : undefined}
          aria-current={aktiv(p.pfad) ? 'page' : undefined}
        >
          {p.titel}
        </a>
      </li>
    ))}
  </ul>
  <a class="nav-cta" href="/kontakt">Erstgespräch</a>
</nav>
